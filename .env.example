# Copy this file to .env.local and adjust. Never commit .env.local.

# ---------------------------------------------------------------------------
# Login switch. Brief hard rule 5: build "none" now, leave a clean place for
# Microsoft Entra ID later. Do not set "microsoft" yet, it is not implemented.
# ---------------------------------------------------------------------------
AUTH_MODE=none

# Admin console PIN (Module 6). Temporary until real login exists.
ADMIN_PIN=123456

# ---------------------------------------------------------------------------
# Data adapter. "sqlite" is for local development only.
# Later: "supabase" or "sharepoint" - a new file in src/data/, no page changes.
# ---------------------------------------------------------------------------
DATA_ADAPTER=sqlite
DATABASE_URL="file:./prisma/dev.db"

# ---------------------------------------------------------------------------
# Event config file. Lets you point at another event without touching code.
# ---------------------------------------------------------------------------
EVENT_CONFIG_PATH=config/event.json
ATTENDEES_CSV_PATH=config/attendees.sample.csv

# ---------------------------------------------------------------------------
# Dev only: pretend it is a different moment, to test the "now" and "next"
# highlight outside the real event dates. Format: YYYY-MM-DDTHH:mm
# Also works as a ?now= URL parameter while NODE_ENV is not production.
# ---------------------------------------------------------------------------
DEV_FAKE_NOW=
# Set to "true" to also allow ?now= on a deployed build (for a rehearsal).
ALLOW_TIME_OVERRIDE=false
