# Copy this file to .env.local and adjust. Never commit .env.local.

# ---------------------------------------------------------------------------
# Login switch. Brief hard rule 5: build "none" now, leave a clean place for
# Microsoft Entra ID later. Do not set "microsoft" yet, it is not implemented.
# ---------------------------------------------------------------------------
AUTH_MODE=none

# Admin console PIN (Module 6). Temporary until real login exists.
ADMIN_PIN=123456

# ---------------------------------------------------------------------------
# Data adapter. "sqlite" for local work, "postgres" when hosted (Neon).
# For postgres, DATABASE_URL is a postgresql://... connection string.
# See docs/DEPLOYING.md.
# ---------------------------------------------------------------------------
DATA_ADAPTER=sqlite
DATABASE_URL="file:./prisma/dev.db"
# With Neon, `neon deploy` or `neon env pull` writes these for you:
# DATABASE_URL (pooled), DATABASE_URL_UNPOOLED (direct, used to create the
# tables), and AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT_URL_S3,
# AWS_REGION for the photo bucket. Photos go to the bucket only with
# DATA_ADAPTER=postgres; PHOTO_STORAGE=database keeps them in Postgres.
# PG_DRIVER=neon-websocket only where port 5432 is blocked.

# ---------------------------------------------------------------------------
# Event pass. When set, only people with this code (carried by the event QR
# codes) can open the portal. Leave empty for local work.
# ---------------------------------------------------------------------------
EVENT_PASS=

# The hosted address. Overrides event.portalUrl in the config file.
PORTAL_URL=

# ---------------------------------------------------------------------------
# Event config file. Lets you point at another event without touching code.
# ---------------------------------------------------------------------------
EVENT_CONFIG_PATH=config/event.json
ATTENDEES_CSV_PATH=config/attendees.sample.csv

# ---------------------------------------------------------------------------
# Dev only: pretend it is a different moment, to test the "now" and "next"
# highlight outside the real event dates. Format: YYYY-MM-DDTHH:mm
# Also works as a ?now= URL parameter while NODE_ENV is not production.
# ---------------------------------------------------------------------------
DEV_FAKE_NOW=
# Set to "true" to also allow ?now= on a deployed build (for a rehearsal).
ALLOW_TIME_OVERRIDE=false
